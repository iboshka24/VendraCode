{
  "name": "vendracode",
  "version": "1.5.0",
  "description": "VendraCode \u2014 Multiplayer AI-native IDE. Your agents, working as one.",
  "homepage": "https://github.com/iboshka24/VendraCode",
  "author": "VendraCode Team <team@vendracode.dev>",
  "license": "MIT",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "dev:electron": "concurrently \"vite\" \"wait-on http://localhost:5173 && cross-env NODE_ENV=development electron .\"",
    "build": "vite build",
    "start": "cross-env NODE_ENV=production electron .",
    "build:linux": "vite build && electron-builder --linux --publish never",
    "build:win": "vite build && electron-builder --win --publish never",
    "build:mac": "vite build && electron-builder --mac --publish never",
    "build:all": "vite build && electron-builder --linux --win --mac --publish never",
    "build:win:full": "vite build && electron-builder --win --publish never",
    "build:win:installer": "vite build && electron-builder --win nsis --publish never",
    "build:win:portable": "vite build && electron-builder --win portable --publish never",
    "build:win:fast": "vite build && electron-builder --win --dir --publish never",
    "test:app": "node tests/full-app-verify.mjs",
    "test:multiplayer": "node tests/multiplayer-verify.mjs",
    "test:zen": "node tests/zen-e2e.mjs",
    "test": "npm run test:unit && npm run test:app && npm run test:multiplayer && npm run test:multiplayer-agent && npm run test:zen && npm run test:agent && npm run test:stop",
    "test:unit": "node tests/cli-locate.test.mjs && node tests/lock-store.test.mjs && node tests/daemon-token.test.mjs && node tests/toolchain-pins.test.mjs && node tests/codex-stream.test.mjs && node tests/codex-models.test.cjs && node tests/swarm-worker.test.mjs && node tests/swarm-join.test.cjs && node tests/swarm-paths.test.mjs && node tests/mcp.test.cjs && node tests/agent-context.test.cjs && node tests/agent-events.test.mjs && node tests/agent-usage.test.cjs && node tests/agent-chat-store.test.cjs",
    "test:agent": "node tests/agent-e2e.mjs",
    "test:multiplayer-agent": "node tests/multiplayer-agent-verify.mjs",
    "test:stop": "node tests/stop-verify.mjs",
    "test:swarm:live": "node tests/swarm-live.mjs",
    "test:swarm:win": "node tests/swarm-win-e2e.cjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@monaco-editor/react": "^4.6.0",
    "cross-spawn": "7.0.6",
    "framer-motion": "^11.0.3",
    "lucide-react": "^0.323.0",
    "monaco-editor": "^0.57.0",
    "node-pty": "^1.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-markdown": "^9.1.0",
    "remark-gfm": "^4.0.1",
    "simple-git": "^3.22.0",
    "xterm": "^5.3.0",
    "xterm-addon-fit": "^0.8.0",
    "xterm-addon-web-links": "^0.9.0",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.16",
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.17",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^29.1.0",
    "electron-builder": "^24.13.1",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3",
    "vite": "^5.1.0",
    "wait-on": "^7.2.0",
    "ws": "^8.22.0"
  },
  "build": {
    "appId": "com.vendracode.ide",
    "productName": "VendraCode",
    "asar": true,
    "asarUnpack": [
      "**/node_modules/node-pty/**"
    ],
    "files": [
      "dist/**/*",
      "electron/**/*",
      "node_modules/node-pty/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.icns"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development",
      "icon": "build/icon.png"
    }
  },
  "allowScripts": {
    "node-pty@1.1.0": true,
    "electron@29.4.6": true
  }
}
